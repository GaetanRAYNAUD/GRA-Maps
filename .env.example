# Copy to .env (ignored by git) and fill in. Never commit real values.
# Loaded by `npm run publish:data` (node --env-file-if-exists=.env) and by wrangler.

# Cloudflare account (not a secret, can also go in wrangler.toml as account_id)
CLOUDFLARE_ACCOUNT_ID=

# R2 data bucket behind maps-data.gaetanraynaud.fr
# R2 > Manage API tokens, Object Read & Write on this bucket only
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cache purge after publication
# Zone ID of gaetanraynaud.fr (zone Overview page), token with Zone > Cache Purge only
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
